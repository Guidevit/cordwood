{
  "name": "@cordwood/tour",
  "version": "0.1.0",
  "description": "Guided tours: which a person has seen, kept on the server, and a headless controller that walks the steps on the page.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guidevit/cordwood.git",
    "directory": "packages/tour"
  },
  "homepage": "https://github.com/Guidevit/cordwood/tree/main/packages/tour#readme",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@cordwood/firebase": "workspace:^"
  },
  "peerDependencies": {
    "firebase-admin": ">=13",
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "firebase-admin": "^14.5.0",
    "jsdom": "^27.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
