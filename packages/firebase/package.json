{
  "name": "@cordwood/firebase",
  "version": "0.1.1",
  "description": "The server's seam to Firebase through firebase-admin: one app, and the tenant every other cordwood package writes under.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guidevit/cordwood.git",
    "directory": "packages/firebase"
  },
  "homepage": "https://github.com/Guidevit/cordwood/tree/main/packages/firebase#readme",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "cordwood-firebase": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
