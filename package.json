{
  "name": "cordwood",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "firebase emulators:exec --only auth,firestore --project demo-cordwood \"vitest run\"",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "test:unit": "vitest run --exclude \"**/*.emulator.test.ts\"",
    "test:stripe": "firebase emulators:exec --only auth,firestore --project demo-cordwood \"node --env-file=.env ./node_modules/vitest/vitest.mjs run packages/billing/src/billing.stripe.test.ts\""
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.5",
    "firebase-tools": "^15.33.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
